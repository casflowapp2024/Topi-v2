# Copia este archivo a infra/.env (no se commitea).
POSTGRES_USER=topi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cashflow
POSTGRES_PORT=5432
API_PORT=8080
APP_ENV=development
LOG_LEVEL=INFO
HTTP_ALLOWED_ORIGINS=http://localhost:3000

# Auth (obligatorio): openssl rand -hex 32
JWT_SECRET=<openssl-rand-hex-32>
# X-API-Key del worker para rutas admin/* (vacío = deshabilitado)
INTERNAL_API_KEY=<openssl-rand-hex-32>
# Opcional: fecha límite para que los migrados creen su contraseña (YYYY-MM-DD o RFC3339)
INITIAL_PASSWORD_UNTIL=
# Vida del access token (el front lo renueva con el refresh token). Corto solo para probar la renovación.
ACCESS_TOKEN_TTL=1h

# Front: puerto local y URL de la API horneada en el build (cambiarla exige rebuild del servicio web)
WEB_PORT=3000
WEB_API_URL=http://localhost:8080

# Ruta al dump (relativa a infra/ o absoluta). Por defecto: topiv2/cashflowprod.dump
# DUMP_FILE=../../cashflowprod.dump

# Worker de correos. Por defecto en local NO toca correos reales (dry run y ninguna conexión).
# Prueba real solo con la conexión del equipo: WORKER_ONLY_EMAIL_IDS=<emails.id>, primero con dry run.
WORKER_DRY_RUN=true
WORKER_ONLY_EMAIL_IDS=0
SCHEDULER_ENABLED=true
