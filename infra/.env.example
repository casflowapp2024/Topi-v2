# Copia este archivo a infra/.env (no se commitea).
POSTGRES_USER=topi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cashflow
POSTGRES_PORT=5432
API_PORT=8080
APP_ENV=development
LOG_LEVEL=INFO
HTTP_ALLOWED_ORIGINS=http://localhost:3000

# Auth (obligatorio): openssl rand -hex 32
JWT_SECRET=<openssl-rand-hex-32>
# X-API-Key del worker/n8n para rutas admin/* (vacío = deshabilitado)
INTERNAL_API_KEY=<openssl-rand-hex-32>
# Opcional: fecha límite para que los migrados creen su contraseña (YYYY-MM-DD o RFC3339)
INITIAL_PASSWORD_UNTIL=

# Ruta al dump (relativa a infra/ o absoluta). Por defecto: topiv2/cashflowprod.dump
# DUMP_FILE=../../cashflowprod.dump
