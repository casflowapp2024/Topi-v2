            "id": "c138af61-f4f7-4632-9df7-22bd6f1bfd8c",
            "name": "Set Variables",
            "type": "n8n-nodes-base.set",
            "typeVersion": 3.4,
            "position": [
                380,
                300
            ]
        },
        {
            "parameters": {
                "promptType": "define",
                "text": "={{$json.message}}",
                "options": {
                    "systemMessage": "Eres TopiBot, un experto asesor financiero personal. \nTienes a tu disposición herramientas para consultar los saldos de las cuentas, presupuestos categorizados y reportes financieros del usuario. Usa esta información para responder sus dudas basándote siempre en sus datos reales.\nSi necesitas filtrar por fechas usa formato AAAA-MM-DD. Si no sabes algo, pídele amablemente al usuario aclaraciones."
                }
            },
            "id": "agent-node-1",
            "name": "AI Agent",
            "type": "@n8n/n8n-nodes-langchain.agent",
            "typeVersion": 1.1,
            "position": [
                560,
                300
            ]
        },
        {
            "parameters": {
                "model": "gemini-1.5-pro-latest"
            },
            "id": "gemini-model-1",
            "name": "Google Gemini Chat Model",
            "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
            "typeVersion": 1,
            "position": [
                560,
                500
            ],
            "credentials": {
                "googleApi": {
                    "id": "",
                    "name": "Google API"
                }
            }
        },
        {
            "parameters": {
                "sessionId": "={{$json.sessionId}}"
            },
            "id": "window-buffer-memory",
            "name": "Window Buffer Memory",
            "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
            "typeVersion": 1.2,
            "position": [
                700,
                500
            ]
        },
        {
            "parameters": {
                "toolDescription": "Llama a esta herramienta cuando el usuario pregunte por sus cuentas bancarias, tarjetas o efectivo, o para saber su balance actual en ellas. No necesita parámetros extras.",
                "method": "GET",
                "url": "={{$json.baseUrl}}/accounts/list?skip=0&limit=50",
                "sendHeaders": true,
                "parametersHeaders": {
                    "values": [
                        {
                            "name": "Authorization",
                            "valueProvider": "fieldValue",
                            "value": "=Bearer {{$json.token}}"
                        }
                    ]
                }
            },
            "id": "tool-cuentas",
            "name": "Consultar_Cuentas",
            "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
            "typeVersion": 1,
            "position": [
                860,
                420
            ]
        },
        {
            "parameters": {
                "toolDescription": "Busca y retorna un arreglo de transacciones (ingresos, gastos). Cada objeto contiene amount (monto), date (fecha), category (categoría relacionada) y description (descripción). DEBES usar parámetros como init_date y end_date (formato YYYY-MM-DD), keyword (palabra a buscar), id de cuenta, entre otros si el usuario lo requiere.",
                "method": "GET",
                "url": "={{$json.baseUrl}}/transactions/list",
                "sendHeaders": true,
                "parametersHeaders": {
                    "values": [
                        {
                            "name": "Authorization",
                            "valueProvider": "fieldValue",
                            "value": "=Bearer {{$json.token}}"
                        }
                    ]
                },
                "sendQuery": true,
                "specifyQuery": "json",
                "jsonQuery": "={\n  \"skip\": 0,\n  \"limit\": 50,\n  \"init_date\": \"{{$parameter.init_date || ''}}\",\n  \"end_date\": \"{{$parameter.end_date || ''}}\",\n  \"keyword\": \"{{$parameter.keyword || ''}}\"\n}",
                "specifyInputSchema": true,
                "jsonSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"init_date\": {\n      \"type\": \"string\",\n      \"description\": \"Fecha inicial en formato YYYY-MM-DD. Dejar vacio si no se menciona.\"\n    },\n    \"end_date\": {\n      \"type\": \"string\",\n      \"description\": \"Fecha final en formato YYYY-MM-DD. Dejar vacio si no se menciona.\"\n    },\n    \"keyword\": {\n      \"type\": \"string\",\n      \"description\": \"Palabra clave a buscar en la transaccion. Dejar vacio si no se menciona\"\n    }\n  }\n}"
            },
            "id": "tool-transacciones",
            "name": "Consultar_Transacciones",
            "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
            "typeVersion": 1,
            "position": [
                940,
                420
            ]
        },
        {
            "parameters": {
                "toolDescription": "Esta herramienta devuelve el consolidado del Balance histórico y Gastos por período. Retorna totales de: income (ingresos), expenses (gastos) y saving (ahorro o balance neto) para un mes especificado. Requiere el parámetro 'date' (YYYY-MM-DD).",
                "method": "GET",
                "url": "={{$json.baseUrl}}/analysis/financial-report",
                "sendHeaders": true,
                "parametersHeaders": {
                    "values": [
                        {
                            "name": "Authorization",
                            "valueProvider": "fieldValue",
                            "value": "=Bearer {{$json.token}}"
                        }
                    ]
                },
                "sendQuery": true,
                "specifyQuery": "json",
                "jsonQuery": "={\n  \"date\": \"{{$parameter.date || ''}}\"\n}",
                "specifyInputSchema": true,
                "jsonSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"date\": {\n      \"type\": \"string\",\n      \"description\": \"Fecha en formato YYYY-MM-DD\"\n    }\n  }\n}"
            },
            "id": "tool-reporte",
            "name": "Reporte_Financiero",
            "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
            "typeVersion": 1,
            "position": [
                1020,
                420
            ]
        },
        {
            "parameters": {
                "toolDescription": "Llama a esta herramienta cuando el usuario pregunte por las categorías que tiene creadas, sus iconos (emojis) o sus presupuestos configurados.",
                "method": "GET",
                "url": "={{$json.baseUrl}}/categories/list",
                "sendHeaders": true,
                "parametersHeaders": {
                    "values": [
                        {
                            "name": "Authorization",
                            "valueProvider": "fieldValue",
                            "value": "=Bearer {{$json.token}}"
                        }
                    ]
                }
            },
            "id": "tool-categorias",
            "name": "Obtener_Categorias",
            "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
            "typeVersion": 1,
            "position": [
                1100,
                420
            ]
        }
