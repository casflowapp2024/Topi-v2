# topi-db — Datos para crear la base en Coolify (New Resource → Database → PostgreSQL).
# No son variables de una Application: se escriben en los campos del formulario de la base.
# Leyenda: [secreto] / [no secreto].

# [no secreto] Imagen
POSTGRES_IMAGE=postgres:16-alpine
# [no secreto] Usuario y base inicial
POSTGRES_USER=topi
POSTGRES_DB=cashflow
# [secreto] Generar NUEVA: openssl rand -hex 32. Va también en DB_PASSWORD (api) y DATABASE_URL (worker).
POSTGRES_PASSWORD=<openssl-rand-hex-32>
# [no secreto] NO marcar "Make it publicly available": la base solo se usa por la red interna.
PUBLIC=false

# Backups programados (pestaña de backups de la base; destino S3 configurado aparte en Coolify).
# [no secreto] 03:30 Bogotá = 08:30 UTC (si el servidor está en UTC; ver RUNBOOK B1).
BACKUP_CRON=30 8 * * *
BACKUP_RETENTION=30
# Bucket S3-compatible (Cloudflare R2 o Backblaze B2):
# [no secreto]
S3_ENDPOINT=<https://<account-id>.r2.cloudflarestorage.com | https://s3.<region>.backblazeb2.com>
S3_BUCKET=topi-backups
S3_REGION=<auto (R2) | región de B2, p. ej. us-west-004>
# [secreto] Credenciales del bucket (con permiso solo sobre ese bucket).
S3_ACCESS_KEY=<access-key-id>
S3_SECRET_KEY=<secret-access-key>
