# topi-api — Variables de entorno en Coolify (Application → Environment Variables).
# Todas son de RUNTIME (no marcar "Build Variable"). Sin valores reales: los <...> se rellenan en Coolify.
# Leyenda: [secreto] no compartir, no pegar en chats ni tickets; [no secreto] puede verse.
# Los valores de producción que no son secretos ya vienen puestos.

# [no secreto] Nombre en los logs.
APP_NAME=topi-api
# [no secreto] production apaga /docs (Swagger) y deja Gin en modo release. "prod" también vale.
APP_ENV=production
# [no secreto] DEBUG | INFO | ERROR
LOG_LEVEL=INFO

# [no secreto] Escuchar en todas las interfaces del contenedor, puerto 8080 (= "Ports Exposes").
HTTP_URL=0.0.0.0
HTTP_PORT=8080
# [no secreto] Orígenes del front permitidos por CORS (separados por coma, sin espacios ni barra final).
HTTP_ALLOWED_ORIGINS=https://www.topi.cash,https://topi.cash
# [no secreto] Vacío = Origin,Content-Type,Accept,Authorization
HTTP_ALLOWED_HEADERS=
# [no secreto] Subred de la red Docker de Coolify (donde está el proxy). Sin esto el rate limit ve
# la IP del proxy y no la del usuario. Sacarla en el servidor (ver RUNBOOK, paso B2):
#   docker network inspect coolify -f '{{range .IPAM.Config}}{{.Subnet}}{{end}}'
TRUSTED_PROXIES=<subred-de-la-red-coolify, p. ej. 10.0.1.0/24>

# [no secreto] Postgres interno de Coolify (topi-db). Host = el hostname interno que muestra Coolify.
DB_CONNECTION=postgres
DB_HOST=<hostname-interno-de-topi-db>
DB_PORT=5432
DB_NAME=cashflow
DB_USER=topi
# [secreto] La misma POSTGRES_PASSWORD de topi-db.
DB_PASSWORD=<postgres-password>
# [no secreto] Red interna de Docker: sin TLS.
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=3
DB_CONN_MAX_LIFETIME=5m

# [secreto] Firma de los JWT (>= 32 bytes). Generar NUEVO: openssl rand -hex 32. Nunca el de infra/.env.
JWT_SECRET=<openssl-rand-hex-32>
# [no secreto]
JWT_ISSUER=topi-api
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=720h
# [no secreto] Obsoleta: set-initial-password está cerrado (se usa el código por correo). Dejar vacía.
INITIAL_PASSWORD_UNTIL=
# [secreto] X-API-Key del worker para las rutas admin/*. Generar: openssl rand -hex 32. Igual en topi-worker.
INTERNAL_API_KEY=<openssl-rand-hex-32>
# [no secreto] Intentos por minuto de login/signup/recuperar contraseña, por IP y por email.
RATE_LIMIT_PER_MIN=10

# Correo con Resend (RUNBOOK, sección B8). Primero el dominio verificado en Resend, después estas variables.
# [no secreto] resend en producción; log = no envía nada (los códigos no llegan: nadie podría recuperar
# la contraseña). No usar SMTP: Hetzner lo bloquea.
MAIL_PROVIDER=resend
# [secreto] API key de Resend con permiso "Sending access" restringida al dominio mail.topi.cash.
RESEND_API_KEY=<re_api-key-solo-envio>
# [secreto] Signing secret del webhook de Resend (empieza por whsec_). Sin él, el webhook responde 401.
RESEND_WEBHOOK_SECRET=<whsec_secreto-del-webhook>
# [no secreto]
MAIL_FROM=Topi <hola@mail.topi.cash>
MAIL_REPLY_TO=cashflowapp2024@gmail.com
# [no secreto] Límite diario del plan de Resend (gratis ~100/día; ajustar si cambia el plan).
MAIL_DAILY_QUOTA=100
# [no secreto] Vacío en producción. En staging/desarrollo con resend es OBLIGATORIA (solo esos correos reciben).
MAIL_ONLY_TO=
# [no secreto] Enlaces de los correos (sin barra final).
APP_BASE_URL=https://www.topi.cash
API_BASE_URL=https://api.topi.cash

# [no secreto] Redis no se usa en v1.
REDIS_ADDR=
REDIS_PASSWORD=

# OAuth de Gmail para LEER correos (Google Cloud; mismo client que antes, secret ROTADO).
# [no secreto]
GMAIL_CLIENT_ID=<google-oauth-client-id>
# [secreto] El secret rotado en la Fase 0 / B0.
GMAIL_CLIENT_SECRET=<google-oauth-client-secret>
# [no secreto]
GMAIL_PROJECT_ID=<google-project-id>
GMAIL_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GMAIL_TOKEN_URI=https://oauth2.googleapis.com/token
GMAIL_AUTH_PROVIDER=https://www.googleapis.com/oauth2/v1/certs
# [no secreto] Debe coincidir EXACTAMENTE con el registrado en Google Cloud.
GMAIL_REDIRECT_URIS=https://www.topi.cash/gmail-auth-connect
GMAIL_JAVASCRIPT_ORIGINS=https://www.topi.cash

# OAuth de Outlook para LEER correos (Azure; mismo app registration, secret ROTADO).
# [no secreto]
OUTLOOK_CLIENT_ID=<azure-app-client-id>
# [secreto]
OUTLOOK_CLIENT_SECRET=<azure-app-client-secret>
# [no secreto] Debe coincidir EXACTAMENTE con el registrado en Azure.
OUTLOOK_REDIRECT_URL=https://www.topi.cash/gmail-auth-connect
OUTLOOK_SCOPES=offline_access Mail.Read
OUTLOOK_LOGIN_URL=https://login.microsoftonline.com/common/oauth2/v2.0
OUTLOOK_LOGIN_TIMEOUT=10s
# [no secreto] Panel admin (plan/25). Día del despliegue de la etapa 1: los registrados antes son elegibles a
# fundador. Se aplica al arrancar la API; nunca desmarca a nadie.
FOUNDER_CUTOFF=<YYYY-MM-DD>
# [no secreto] Precios del modelo de lectura (USD por millón de tokens) y costo mensual del servidor (USD)
LLM_PRICE_IN_USD_PER_MTOK=<precio-entrada>
LLM_PRICE_OUT_USD_PER_MTOK=<precio-salida>
SERVER_MONTHLY_COST_USD=<costo-mensual>
