# topi-worker — Variables de entorno en Coolify (Application → Environment Variables).
# Todas son de RUNTIME (no marcar "Build Variable"). Sin valores reales.
# Leyenda: [secreto] / [no secreto]. Salida controlada por etapas (RUNBOOK, paso B5).

# [secreto] Postgres interno (lleva la contraseña). Mismo host/usuario/base que topi-api.
DATABASE_URL=postgresql://topi:<postgres-password>@<hostname-interno-de-topi-db>:5432/cashflow
# [no secreto] La API por la red interna de Coolify (ver RUNBOOK B5: cómo verificar el hostname).
# Alternativa si el hostname interno no resuelve: https://api.topi.cash
API_BASE_URL=http://<hostname-interno-de-topi-api>:8080
# [secreto] La misma INTERNAL_API_KEY de topi-api.
INTERNAL_API_KEY=<misma-que-en-topi-api>

# [no secreto]
WORKER_EXTRACTOR=gemini
# [secreto] API key de Gemini de un proyecto CON facturación activa (en el plan gratis Google puede
# usar el contenido de los correos).
GEMINI_API_KEY=<gemini-api-key>
# [no secreto] No cambiar sin evaluar (CLAUDE.md).
GEMINI_MODEL=gemini-3.5-flash-lite

# OAuth para leer correos: los MISMOS client que topi-api.
# [no secreto]
GMAIL_CLIENT_ID=<google-oauth-client-id>
# [secreto]
GMAIL_CLIENT_SECRET=<google-oauth-client-secret>
# [no secreto]
GMAIL_TOKEN_URI=https://oauth2.googleapis.com/token
OUTLOOK_CLIENT_ID=<azure-app-client-id>
# [secreto]
OUTLOOK_CLIENT_SECRET=<azure-app-client-secret>
# [no secreto]
OUTLOOK_TOKEN_URI=https://login.microsoftonline.com/common/oauth2/v2.0/token

# [no secreto] Comportamiento
WORKER_POLL_SECONDS=5
WORKER_CONCURRENCY=2
SYNC_OVERLAP_MINUTES=60
PROCESSED_EMAIL_RETENTION_DAYS=365
SCHEDULER_ENABLED=true
# tasas de cambio (TRM + BCE) a diario a las 19:00; FX_LOOKBACK_DAYS = días hacia atrás que revisa
FX_SYNC_ENABLED=true
FX_LOOKBACK_DAYS=10
LOG_LEVEL=INFO

# [no secreto] Salida controlada:
#   Etapa 1: WORKER_DRY_RUN=true  + WORKER_ONLY_EMAIL_IDS=<emails.id de la conexión del equipo>
#   Etapa 2: WORKER_DRY_RUN=false + la misma conexión
#   Etapa 3 (Fase 6): WORKER_ONLY_EMAIL_IDS vacío → todas las conexiones activas
# OJO: WORKER_ONLY_EMAIL_IDS vacío = TODAS las conexiones. No dejarlo vacío antes de la Fase 6.
WORKER_DRY_RUN=true
WORKER_ONLY_EMAIL_IDS=<emails.id-de-la-conexion-del-equipo>
