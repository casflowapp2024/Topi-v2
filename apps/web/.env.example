# Copia a apps/web/.env (no se commitea). CRA solo expone variables REACT_APP_* y las hornea en el
# build: en Docker/Coolify se pasan como build args (ver apps/web/Dockerfile).
# URL base de la API, sin barra final (la API nueva no usa el prefijo /prod de API Gateway).
# Producción: https://api.topi.cash
REACT_APP_API_URL=http://localhost:8080
# Opcional: si está vacío no se carga Google Analytics.
REACT_APP_GA_TRACKING_ID=
