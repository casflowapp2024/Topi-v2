# Worker de correos (ex-Saturn). En la Fase 1 el código se copió sin cambios desde las Lambdas;
# se refactoriza en la Fase 3 (cola email_jobs, cron interno, sin SQS/S3/DynamoDB).
# Copia a apps/worker/.env (no se commitea).

# LLM para extraer transacciones
GEMINI_API_KEY=<gemini-api-key>

# API de Topi
API_URL=http://localhost:8080
ADMIN_EMAIL=<admin-email>
ADMIN_PASSWORD=<admin-password>

# Base de datos
DB_ENDPOINT=localhost
DB_USER=topi
DB_PASSWORD=<password-local>

# OAuth Gmail / Outlook (mismos clients que la API)
GMAIL_CLIENT_ID=<google-oauth-client-id>
GMAIL_CLIENT_SECRET=<google-oauth-client-secret>
GMAIL_TOKEN_URI=https://oauth2.googleapis.com/token
OUTLOOK_CLIENT_ID=<azure-app-client-id>
OUTLOOK_CLIENT_SECRET=<azure-app-client-secret>
OUTLOOK_TOKEN_URI=https://login.microsoftonline.com/common/oauth2/v2.0/token

# Solo para scripts de local/ (pruebas manuales)
GMAIL_ACCESS_TOKEN=
GMAIL_REFRESH_TOKEN=
OUTLOOK_REFRESH_TOKEN=
TEST_USER_ID=

# Legacy AWS (se eliminan en la Fase 3)
ENV=
QUEUE_URL=
