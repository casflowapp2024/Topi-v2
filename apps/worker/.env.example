# Worker de correos (Fase 3). Copia a apps/worker/.env (no se commitea).
# Con docker compose, DATABASE_URL, API_BASE_URL e INTERNAL_API_KEY los define infra/docker-compose.yml.

# Conexiones (obligatorias)
DATABASE_URL=postgresql://topi:<password-local>@localhost:5432/cashflow
API_BASE_URL=http://localhost:8080
# header X-API-Key para las rutas admin/*
INTERNAL_API_KEY=<misma-que-en-la-api>

# Extractor (Gemini). La key debe ser de un proyecto CON facturación activa
# (en el plan gratis Google puede usar el contenido de los correos).
WORKER_EXTRACTOR=gemini
GEMINI_API_KEY=<gemini-api-key>
GEMINI_MODEL=gemini-2.5-flash-lite

# OAuth para leer correos (los mismos client_id que la API; rotar el secret no invalida los tokens)
GMAIL_CLIENT_ID=<google-oauth-client-id>
GMAIL_CLIENT_SECRET=<google-oauth-client-secret>
GMAIL_TOKEN_URI=https://oauth2.googleapis.com/token
OUTLOOK_CLIENT_ID=<azure-app-client-id>
OUTLOOK_CLIENT_SECRET=<azure-app-client-secret>
OUTLOOK_TOKEN_URI=https://login.microsoftonline.com/common/oauth2/v2.0/token

# Comportamiento
WORKER_POLL_SECONDS=5
WORKER_CONCURRENCY=2
SYNC_OVERLAP_MINUTES=60
PROCESSED_EMAIL_RETENTION_DAYS=365
SCHEDULER_ENABLED=true
LOG_LEVEL=INFO

# Pruebas con correos REALES: solo conexiones del equipo, primero en dry run.
#   WORKER_DRY_RUN=true  lee y extrae, pero no crea transacciones ni mueve last_run (registra lo que haría)
#   WORKER_ONLY_EMAIL_IDS=26,38  restringe el worker a esas conexiones (emails.id)
WORKER_DRY_RUN=false
WORKER_ONLY_EMAIL_IDS=
