# Copia a apps/api/.env (no se commitea). Con docker compose, las variables APP_*/HTTP_*/DB_*
# y las de auth (JWT_SECRET, INTERNAL_API_KEY...) las define infra/docker-compose.yml desde infra/.env;
# aquí van sobre todo Gmail/Outlook.
# ENV_FILE=.env                      # archivo a cargar si existe (por defecto .env)

APP_NAME=topi-api
# development | production (production oculta /docs)
APP_ENV=development
# DEBUG | INFO | ERROR
LOG_LEVEL=INFO

# 0.0.0.0 dentro de un contenedor
HTTP_URL=127.0.0.1
HTTP_PORT=8080
HTTP_ALLOWED_ORIGINS=http://localhost:3000
# vacío = Origin,Content-Type,Accept,Authorization
HTTP_ALLOWED_HEADERS=
# IPs/CIDR del proxy (Coolify/Traefik) que pueden fijar X-Forwarded-For
TRUSTED_PROXIES=

DB_CONNECTION=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=cashflow
DB_USER=topi
DB_PASSWORD=<password-local>
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# Redis: no se usa en v1 (adaptador sin cablear)
REDIS_ADDR=
REDIS_PASSWORD=

# Auth propia (email + contraseña). JWT_SECRET es OBLIGATORIO (>= 32 bytes): sin él la API no arranca.
# Generar con: openssl rand -hex 32
JWT_SECRET=<openssl-rand-hex-32>
JWT_ISSUER=topi-api
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=720h
# Opcional: cierra /users/set-initial-password después de esta fecha (YYYY-MM-DD = fin del día UTC, o RFC3339)
INITIAL_PASSWORD_UNTIL=
# Opcional: X-API-Key para el worker y n8n en rutas admin/* (vacío = deshabilitado)
INTERNAL_API_KEY=<openssl-rand-hex-32>
# login, signup y set-initial-password, por IP y por email
RATE_LIMIT_PER_MIN=10

# OAuth de Gmail para leer correos (Google Cloud, se mantiene)
GMAIL_CLIENT_ID=<google-oauth-client-id>
GMAIL_CLIENT_SECRET=<google-oauth-client-secret>
GMAIL_PROJECT_ID=<google-project-id>
GMAIL_AUTH_URI=https://accounts.google.com/o/oauth2/auth
GMAIL_TOKEN_URI=https://oauth2.googleapis.com/token
GMAIL_AUTH_PROVIDER=https://www.googleapis.com/oauth2/v1/certs
GMAIL_REDIRECT_URIS=http://localhost:3000/<ruta-callback>
GMAIL_JAVASCRIPT_ORIGINS=http://localhost:3000

# OAuth de Outlook para leer correos (Azure, se mantiene)
OUTLOOK_CLIENT_ID=<azure-app-client-id>
OUTLOOK_CLIENT_SECRET=<azure-app-client-secret>
OUTLOOK_REDIRECT_URL=http://localhost:3000/<ruta-callback>
OUTLOOK_SCOPES=offline_access Mail.Read
OUTLOOK_LOGIN_URL=https://login.microsoftonline.com/common/oauth2/v2.0
OUTLOOK_LOGIN_TIMEOUT=10s
