# build stage
FROM public.ecr.aws/docker/library/golang:1.23-alpine AS build

RUN apk add --no-cache git

# set working directory
WORKDIR /go/src/app

# copy source code
COPY . .

# install dependencies
RUN go mod download

# build binary
RUN CGO_ENABLED=0 GOOS=linux GOARCH=arm64 go build -o /go/bin/cashflow ./cmd/lambda/main.go

# final stage
FROM public.ecr.aws/docker/library/alpine:3.18 AS final
LABEL maintainer="fabioalv"

# set working directory
WORKDIR /go/src/app

RUN apk --no-cache add ca-certificates

# copy binary
COPY --from=build /go/bin/cashflow /app

EXPOSE 8080
LABEL Name=cashflow Version=0.0.1

ENTRYPOINT ["/app"]